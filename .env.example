# ==============================================================================
# PAPAGON INSIGHT - Environment Configuration
# Project: Indonesian News Data & Intelligence Platform
# ==============================================================================

# --- PostgreSQL Database Configuration ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=news_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# --- Scraper & Time Window Configuration ---
CRAWL_INTERVAL_HOURS=6
NEWS_LOOKBACK_HOURS=24

# --- Master Category Ingestion Filter ---
# Only persist these Master Categories to DB (comma-separated). Leave empty to keep all.
ALLOWED_CATEGORIES="Ekonomi & Bisnis,Politik & Hukum,Teknologi & Sains"

# --- Groq AI Intelligence Engine (Free Tier — https://console.groq.com/keys) ---
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# AI Worker Rate & Batch Settings (Hit-and-Run Crontab Tagger)
BATCH_SIZE=5               # Articles per enrichment request (maximum: 5)
MAX_RPM=12                 # Maximum requests per worker run (maximum: 15)
CRON_WORKERS=enrich        # Comma-separated registered workers; empty disables cron
WORKER_CRON_ENRICH=*/1 * * * *
RUN_ENRICH_WORKER_AFTER_CRAWL=false  # Avoid duplicate runs when cron is enabled
